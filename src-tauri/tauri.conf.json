{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cricket",
  "version": "0.1.0",
  "identifier": "com.hnam0212.cricket",
  "build": {
    "beforeDevCommand": "pnpm -C ui dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm -C ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cricket",
        "width": 480,
        "height": 360
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
