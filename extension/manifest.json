{
  "manifest_version": 3,
  "name": "Cricket",
  "version": "0.1.0",
  "description": "Lets the Cricket desktop app use one browser tab as its music source and treat other tabs as activity.",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "storage", "alarms"],
  "background": {
    "service_worker": "dist/background.js"
  },
  "action": {
    "default_title": "Cricket",
    "default_popup": "popup.html"
  },
  "icons": {
    "32": "icons/icon32.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/hook.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["dist/relay.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
